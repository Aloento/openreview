# --- GitHub App ---
# From: GitHub -> Settings -> Developer settings -> GitHub Apps -> your app
GITHUB_APP_ID=123456
# Installation id of the app on the target account.
GITHUB_APP_INSTALLATION_ID=12345678
# PEM private key. Either paste the whole key (with \n for newlines) or
# reference it; the loader normalizes \n and wraps bare keys in PEM headers.
GITHUB_APP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----
# From: GitHub App -> Webhooks -> Webhook secret
GITHUB_APP_WEBHOOK_SECRET=your-webhook-secret

# --- LLM (OpenAI-compatible) ---
LLM_BASE_URL=https://your-llm-gateway/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=your-model-name

# --- Server ---
# HOST=127.0.0.1
# PORT=8090
# debug, info, warn, error
# LOG_LEVEL=info

# --- Review behaviour ---
# Approve the pull request when the review did not request changes.
# AUTO_APPROVE=true
# author_association values allowed to start a review by mentioning the bot.
# TRUSTED_ASSOCIATIONS=OWNER,MEMBER,COLLABORATOR
# Review pull requests opened from a fork.
# REVIEW_FORK_PRS=false
# Where PR branches are cloned for review. Each run gets a private temp dir.
# WORKSPACE_ROOT=workspaces
# LLM tool loop budget.
# MAX_AGENT_STEPS=20
# Hard limit for a single review, from clone to approval.
# RUN_TIMEOUT_MS=1800000
# Timeout for one bash command the agent runs.
# BASH_TIMEOUT_MS=300000
